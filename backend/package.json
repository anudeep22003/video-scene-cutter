{
  "name": "backend",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/dev.ts",
    "build": "npm run generate && esbuild --bundle --format=esm --banner:js='import { createRequire } from \"node:module\"; const require = createRequire(import.meta.url);' --outfile=./dist/index.js --platform=node --target=node22 ./src/index.ts",
    "zip": "zip -j lambda.zip dist/index.js",
    "update": "aws lambda update-function-code --zip-file fileb://lambda.zip --function-name hello",
    "deploy": "run-s build zip update",
    "generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/**/*.test.ts",
    "format": "prettier --write . && prisma format",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@hono/node-server": "^2.1.5",
    "@types/node": "^26.1.1",
    "esbuild": "^0.28.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "npm-run-all2": "^9.0.2",
    "prettier": "^3.9.10",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.72.0"
  },
  "dependencies": {
    "@hono/aws-lambda": "^1.0.0",
    "@prisma/adapter-neon": "^7.10.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "dotenv": "^18.0.9",
    "hono": "^4.13.13",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  }
}
