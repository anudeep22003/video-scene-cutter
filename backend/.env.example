# Pooled Neon URL for the application; never commit real credentials.
DATABASE_URL=postgresql://user:password@your-endpoint-pooler.eu-west-2.aws.neon.tech/neondb?sslmode=require
# Direct Neon URL for Prisma migrations.
DIRECT_URL=postgresql://user:password@your-endpoint.eu-west-2.aws.neon.tech/neondb?sslmode=require
