# Local-only credentials matching the root compose.yaml.
DATABASE_DRIVER=postgres
DATABASE_URL=postgresql://video_slicer:video_slicer@localhost:5432/video_slicer
DIRECT_URL=postgresql://video_slicer:video_slicer@localhost:5432/video_slicer

# For Neon, set DATABASE_DRIVER=neon, DATABASE_URL to the pooled Neon URL,
# and DIRECT_URL to the direct Neon URL. Never commit real credentials.
